page {
  background: #f3f5f7;
  color: #17212b;
  font-size: 28rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.container {
  padding: 32rpx 28rpx 48rpx;
}

.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.eyebrow {
  color: #6b7280;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.page-title {
  margin-top: 4rpx;
  color: #17212b;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.section-title {
  color: #17212b;
  font-size: 32rpx;
  font-weight: 700;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 0 16rpx;
}

.section-action {
  color: #0f766e;
  font-size: 24rpx;
  padding: 8rpx 0 8rpx 20rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e1e6e4;
  border-radius: 10rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  font-size: 28rpx;
  margin: 0;
}

.btn-primary {
  background: #0f766e;
  color: #ffffff;
  font-weight: 600;
}

.btn-primary:active {
  background: #0b5f59;
}

.btn-secondary {
  background: #ffffff;
  border: 1rpx solid #0f766e;
  color: #0f766e;
}

.btn-quiet {
  background: #eef2f3;
  color: #344054;
}

.btn[disabled] {
  background: #d9dee2;
  color: #88929c;
  opacity: 1;
}

.muted {
  color: #6b7280;
  font-size: 24rpx;
}

.error {
  color: #a33a2b;
  background: #fff1ef;
  border: 1rpx solid #f2c9c2;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  margin: 16rpx 0;
  line-height: 1.45;
}

.ok {
  color: #0f766e;
  background: #edf8f2;
  border: 1rpx solid #c9e9d9;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  margin-top: 16rpx;
}

.label {
  color: #344054;
  font-size: 24rpx;
  margin: 20rpx 0 8rpx;
}

.input {
  width: 100%;
  height: 84rpx;
  box-sizing: border-box;
  background: #f8fafb;
  border: 1rpx solid #d9e0e5;
  border-radius: 8rpx;
  padding: 0 18rpx;
  color: #17212b;
}

.input:focus {
  border-color: #0f766e;
}
