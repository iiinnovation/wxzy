.study-page{height:100vh;box-sizing:border-box;padding:24rpx 30rpx 30rpx;display:flex;flex-direction:column;background:#f5f7f6}.study-head{height:70rpx;display:flex;align-items:center;justify-content:space-between}.exit-button{margin:0;padding:0;background:transparent;color:#53616b;font-size:24rpx}.exit-button::after,.source-button::after,.submit-error button::after{border:0}.study-stage{font-size:25rpx;font-weight:650}.head-spacer{width:60rpx}.session-error{margin-top:12rpx;padding:12rpx 16rpx;border-left:5rpx solid #a53d3d;background:#fff0ee;color:#8f382f;font-size:22rpx;line-height:1.45}.task-area{flex:1;min-height:0;display:flex;flex-direction:column;padding-top:28rpx}.context-line{font-size:22rpx;color:#6c7880}.question-scroll{max-height:32vh;margin-top:18rpx}.question-text{font-size:38rpx;line-height:1.55;font-weight:600;color:#18232a;white-space:pre-wrap}.written-input{box-sizing:border-box;width:100%;min-height:130rpx;max-height:240rpx;margin-top:28rpx;padding:20rpx;border:1rpx solid #ccd6d2;border-radius:8rpx;background:#fff;font-size:26rpx}.reveal-button{margin-top:24rpx;height:90rpx;line-height:90rpx;border-radius:8rpx;background:#17664d;color:#fff;font-size:29rpx}.reveal-button::after{border:0}.answer-area{flex:1;min-height:0;margin-top:24rpx}.answer-label{font-size:22rpx;color:#69757d;margin-bottom:10rpx}.answer-scroll{max-height:27vh;padding:20rpx;box-sizing:border-box;background:#fff;border-left:6rpx solid #76998b}.answer-text{font-size:29rpx;line-height:1.7;white-space:pre-wrap}.answer-point{margin-top:12rpx;font-size:25rpx;line-height:1.55}.written-review{margin-top:16rpx;padding:14rpx 18rpx;background:#edf1f3;font-size:23rpx;line-height:1.55;max-height:120rpx;overflow:auto}.source-button{margin:12rpx 0 14rpx;padding:0;background:transparent;text-align:left;color:#315d75;font-size:24rpx}.submit-error{margin-bottom:12rpx;padding:14rpx;background:#fff0ee;color:#8f382f;font-size:22rpx}.submit-error button{margin:8rpx 0 0;padding:0;background:transparent;color:#17664d;font-size:22rpx;text-align:left}
