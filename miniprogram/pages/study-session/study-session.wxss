.study-page{height:100vh;box-sizing:border-box;padding:24rpx 30rpx 30rpx;display:flex;flex-direction:column;background:#f5f7f6}.study-head{height:70rpx;display:flex;align-items:center;justify-content:space-between}.exit-button{margin:0;padding:0;background:transparent;color:#53616b;font-size:24rpx}.exit-button::after,.source-button::after,.submit-error button::after,.recall-mode-option::after,.recall-none-button::after{border:0}.study-stage{font-size:25rpx;font-weight:600}.head-spacer{width:60rpx}.session-error{margin-top:12rpx;padding:12rpx 16rpx;border-left:5rpx solid #a53d3d;background:#fff0ee;color:#8f382f;font-size:22rpx;line-height:1.45}.task-area{flex:1;height:0;min-height:0;box-sizing:border-box;padding-top:28rpx;padding-bottom:30rpx}.context-line{font-size:22rpx;color:#6c7880}.question-block{margin-top:18rpx}.question-text{font-size:38rpx;line-height:1.55;font-weight:600;color:#18232a;white-space:pre-wrap}.recall-mode-selector{display:flex;margin-top:26rpx;padding:4rpx;border:1rpx solid #ccd6d2;border-radius:8rpx;background:#e9eeec}.recall-mode-option{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:50%;height:68rpx;margin:0;padding:0;border-radius:6rpx;background:transparent;color:#53616b;font-size:25rpx}.recall-mode-option.active{background:#fff;color:#0c5d57;font-weight:600}.written-input{box-sizing:border-box;width:100%;min-height:130rpx;max-height:240rpx;margin-top:18rpx;padding:20rpx;border:1rpx solid #ccd6d2;border-radius:8rpx;background:#fff;font-size:26rpx}.reveal-button{display:flex;align-items:center;justify-content:center;margin-top:22rpx;height:90rpx;border-radius:8rpx;background:#0f766e;color:#fff;font-size:29rpx}.reveal-button::after{border:0}.answer-area{margin-top:24rpx}.answer-review-content{margin-bottom:6rpx}.answer-label{font-size:22rpx;color:#69757d;margin-bottom:10rpx}.answer-card{padding:20rpx;box-sizing:border-box;background:#fff;border-left:6rpx solid #76998b}.answer-text{font-size:29rpx;line-height:1.7;white-space:pre-wrap}.point-check-section{margin-top:20rpx}.answer-point-check{display:flex;align-items:flex-start;gap:12rpx;box-sizing:border-box;width:100%;margin-bottom:10rpx;padding:16rpx 18rpx;border:1rpx solid #d4ddda;border-radius:6rpx;background:#fff;color:#26313a;font-size:25rpx;line-height:1.5}.answer-point-check checkbox{flex:none;margin-top:1rpx}.recall-none-button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;height:66rpx;margin:8rpx 0 0;padding:0;border:1rpx solid #c8d2ce;border-radius:6rpx;background:transparent;color:#53616b;font-size:23rpx}.recall-none-button.active{border-color:#a86159;background:#fff3f1;color:#8f382f;font-weight:600}.recall-none-button[disabled]{opacity:.55}.written-review{margin-top:16rpx;padding:14rpx 18rpx;background:#edf1f3;font-size:23rpx;line-height:1.55;max-height:120rpx;overflow:auto}.source-button{margin:12rpx 0 14rpx;padding:0;background:transparent;text-align:left;color:#315d75;font-size:24rpx}.rating-section{margin-top:6rpx;padding-top:18rpx;border-top:1rpx solid #d9e0dd}.submit-error{margin:0 0 12rpx;padding:14rpx;background:#fff0ee;color:#8f382f;font-size:22rpx}.submit-error button{margin:8rpx 0 0;padding:0;background:transparent;color:#0f766e;font-size:22rpx;text-align:left}
