<view class="subjects-page"><view class="subject-head"><view><view class="eyebrow">已发布学习内容</view><view class="page-title">学科</view></view><view class="book-count" wx:if="{{state === 'ready'}}">{{books.length}} 本</view></view><state-view wx:if="{{state === 'loading'}}" type="loading" title="正在加载学科"></state-view><state-view wx:elif="{{state === 'empty'}}" type="empty" title="尚无已发布内容" message="发布通过审核的学习卡后，会按书籍显示在这里"></state-view><state-view wx:elif="{{state === 'error'}}" type="error" title="学科没有加载成功" message="{{errorView.message}}" action-label="重试" bind:action="onRetry"></state-view><state-view wx:elif="{{state === 'unauthorized'}}" type="unauthorized" title="需要重新登录" action-label="前往登录" bind:action="onLogin"></state-view><view wx:else class="subject-list"><view class="subject-row" wx:for="{{books}}" wx:key="id" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onOpenBook"><view class="subject-main"><view class="subject-name">{{item.name}}</view><view class="subject-meta">{{item.subject || '未分类'}} · {{item.chapter_count}} 章</view></view><view class="subject-counts"><view><text>{{item.published_card_count}}</text><text>发布</text></view><view><text>{{item.enrolled_card_count}}</text><text>加入</text></view><view><text>{{item.active_card_count}}</text><text>学习中</text></view><view><text>{{item.mastered_card_count}}</text><text>掌握</text></view></view><progress-bar value="{{item.mastered_card_count}}" total="{{item.active_card_count}}" label="当前掌握"></progress-bar></view></view></view>
