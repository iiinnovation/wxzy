.chapter-page{padding:28rpx 30rpx 80rpx}.chapter-title{font-size:38rpx;font-weight:700;margin-bottom:22rpx}.chapter-tabs{white-space:nowrap;border-bottom:1rpx solid #e1e6e4}.chapter-tab{display:inline-block;max-width:300rpx;padding:18rpx 22rpx;color:#66727d;font-size:24rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.chapter-tab.is-active{color:#0f766e;border-bottom:5rpx solid #0f766e;font-weight:600}.chapter-summary{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:26rpx 0}.chapter-copy{min-width:0;flex:1}.active-title{font-size:30rpx;font-weight:600}.summary-meta,.summary-status{margin-top:8rpx;color:#78838b;font-size:21rpx;line-height:1.45}.summary-status{color:#415b6c}.chapter-action{display:flex;align-items:center;justify-content:center;flex:0 0 190rpx;margin:0;padding:0 14rpx;height:68rpx;border-radius:8rpx;background:#0f766e;color:#fff;font-size:23rpx}.chapter-action.is-secondary{background:#e9efec;color:#0f766e}.chapter-action[disabled]{background:#e4e8e6;color:#87918c}.chapter-action::after,.search-row button::after{border:0}.inline-error{margin:0 0 16rpx;padding:14rpx 18rpx;border-left:5rpx solid #a53d3d;background:#fff1f0;color:#8f382f;font-size:23rpx;line-height:1.45}.search-row{display:flex;margin-bottom:12rpx}.search-row input{box-sizing:border-box;flex:1;height:72rpx;padding:0 18rpx;background:#fff;border:1rpx solid #ccd6d2;border-radius:8rpx 0 0 8rpx;font-size:24rpx}.search-row button{display:flex;align-items:center;justify-content:center;margin:0;width:120rpx;height:72rpx;border-radius:0 8rpx 8rpx 0;background:#415b6c;color:#fff;font-size:23rpx}.card-row{padding:24rpx 0;border-bottom:1rpx solid #e1e6e4}.card-question{font-size:27rpx;line-height:1.5;overflow-wrap:break-word}.card-meta{margin-top:8rpx;color:#77828a;font-size:21rpx}.load-more{margin-top:24rpx;background:#e9efec;color:#0f766e;font-size:24rpx}
