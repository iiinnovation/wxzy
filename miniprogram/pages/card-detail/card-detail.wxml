<view class="detail-page"><state-view wx:if="{{state === 'loading'}}" type="loading" title="正在加载卡片"></state-view><state-view wx:elif="{{state === 'unauthorized'}}" type="unauthorized" title="需要重新登录" action-label="前往登录" bind:action="onLogin"></state-view><state-view wx:elif="{{state === 'error'}}" type="error" title="卡片加载失败" message="{{errorView.message}}" action-label="重试" bind:action="onRetry"></state-view><block wx:else><view class="detail-context">{{detail.card.book_name}} · {{detail.card.chapter || detail.card.section || '未分节'}}</view><text selectable class="detail-question">{{detail.card.question}}</text><view class="detail-answer-label">参考答案</view><text selectable class="detail-answer">{{detail.card.answer}}</text><view class="detail-point" wx:for="{{detail.card.answer_points}}" wx:key="*this">• {{item}}</view><view class="detail-tags"><text wx:for="{{detail.card.tags}}" wx:key="*this">{{item}}</text></view><view class="detail-status"><view><text>加入状态</text><text>{{detail.enrollmentStatusLabel}}</text></view><view><text>当前掌握</text><text>{{detail.masteryLabel}}</text></view></view><view class="detail-inline-error" wx:if="{{inlineError}}">{{inlineError}}</view><button class="detail-primary" wx:if="{{!detail.enrollment_id}}" loading="{{changing}}" disabled="{{changing}}" bindtap="onJoin">加入学习</button><button class="detail-secondary" wx:elif="{{detail.enrollment_status === 'active' || detail.enrollment_status === 'suspended'}}" loading="{{changing}}" disabled="{{changing}}" bindtap="onToggleStatus">{{detail.enrollment_status === 'suspended' ? '恢复学习' : '暂停学习'}}</button><button class="source-link" bindtap="onOpenSource">查看 {{detail.sources.length}} 条来源</button><view class="source-preview" wx:if="{{detail.card.source_excerpt}}"><view>来源摘录</view><text selectable>{{detail.card.source_excerpt}}</text></view></block><source-drawer open="{{sourceOpen}}" sources="{{detail.sources}}" bind:close="onCloseSource"></source-drawer></view>
