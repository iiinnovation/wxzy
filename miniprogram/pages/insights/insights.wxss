.insights-page{padding:32rpx 30rpx 120rpx}.insights-head{height:108rpx}.metric-strip{display:flex;padding:22rpx 0;border-top:1rpx solid #e1e6e4;border-bottom:1rpx solid #e1e6e4}.metric-strip view{width:25%;text-align:center;border-right:1rpx solid #e1e6e4}.metric-strip view:last-child{border:0}.metric-strip text{display:block}.metric-strip text:first-child{font-size:31rpx;font-weight:700}.metric-strip text:last-child{font-size:20rpx;color:#748088}.insight-section{margin-top:34rpx}.section-title{font-size:29rpx;font-weight:600;margin-bottom:14rpx}.measure-row{display:flex;justify-content:space-between;padding:15rpx 0;border-bottom:1rpx solid #e1e6e4;font-size:24rpx}.measure-row text:last-child{font-weight:600}.workload-row{display:flex;align-items:center;height:70rpx}.workload-label{width:96rpx;font-size:21rpx;color:#64717a}.workload-track{flex:1;height:14rpx;background:#e1e7e4;border-radius:8rpx;overflow:hidden}.workload-fill{height:14rpx;background:#4d806c}.workload-fill.is-over{background:#b67a23}.workload-copy{width:146rpx;margin-left:14rpx}.workload-copy text{display:block;font-size:20rpx}.workload-copy text:last-child{color:#78838b}.trend-row,.weak-row{padding:20rpx 0;border-bottom:1rpx solid #e1e6e4}.trend-row{display:flex;justify-content:space-between;align-items:center}.trend-name,.weak-topic{font-size:26rpx;font-weight:600;overflow-wrap:break-word}.trend-evidence,.weak-reason,.weak-action{margin-top:6rpx;color:#748088;font-size:21rpx;line-height:1.5;overflow-wrap:break-word}.trend-label{font-size:21rpx;color:#315d75;margin-left:14rpx}.section-heading{display:flex;justify-content:space-between;color:#315d75;font-size:23rpx}.section-heading .section-title{color:#17212b}.weak-action{color:#315d75}.weekly-entry{display:flex;align-items:center;justify-content:center;margin-top:34rpx;height:82rpx;border-radius:8rpx;background:#415b6c;color:#fff;font-size:26rpx}.weekly-entry::after{border:0}
