<view class="insights-page"><view class="insights-head"><view><view class="eyebrow">学习事实与未来负荷</view><view class="page-title">进度</view></view></view><state-view wx:if="{{state === 'loading'}}" type="loading" title="正在汇总学习记录"></state-view><state-view wx:elif="{{state === 'error'}}" type="error" title="进度没有加载成功" message="{{errorView.message}}" action-label="重试" bind:action="onRetry"></state-view><state-view wx:elif="{{state === 'unauthorized'}}" type="unauthorized" title="需要重新登录" action-label="前往登录" bind:action="onLogin"></state-view><block wx:else><view class="metric-strip"><view><text>{{summary.today_actual_minutes}}</text><text>今日分钟</text></view><view><text>{{summary.today_review_count}}</text><text>今日复习</text></view><view><text>{{summary.backlog_count}}</text><text>当前积压</text></view><view><text>{{summary.study_days}}</text><text>学习天数</text></view></view><view class="insight-section"><view class="section-title">内容与掌握</view><view class="measure-row"><text>内容覆盖</text><text>{{summary.content.covered_page_count}} / {{summary.content.document_page_count}} 页</text></view><view class="measure-row"><text>已发布卡片</text><text>{{summary.content.published_card_count}}</text></view><view class="measure-row"><text>已加入学习</text><text>{{summary.content.enrolled_card_count}}</text></view><view class="measure-row"><text>当前掌握</text><text>{{summary.content.mastered_card_count}}</text></view></view><view class="insight-section"><view class="section-title">未来 7 天</view><view class="workload-row" wx:for="{{workloadDays}}" wx:key="local_date"><view class="workload-label">{{item.label}}</view><view class="workload-track"><view class="workload-fill {{item.overloaded ? 'is-over' : ''}}" style="width:{{item.width}}%"></view></view><view class="workload-copy"><text>{{item.estimated_minutes}} 分钟</text><text>{{item.status_label}}</text></view></view></view><view class="insight-section"><view class="section-title">学科趋势</view><view class="trend-row" wx:for="{{summary.subjects}}" wx:key="subject"><view><view class="trend-name">{{item.subject}}</view><view class="trend-evidence">30 天 {{item.attempt_count_30d}} 次 · Again {{item.again_count_30d}} · Hard {{item.hard_count_30d}}</view></view><view class="trend-label">{{item.trend_label}}</view></view><state-view wx:if="{{!summary.subjects.length}}" type="empty" title="数据还不够" message="完成几次学习后会显示学科趋势"></state-view></view><view class="insight-section"><view class="section-heading"><view class="section-title">薄弱点</view><view bindtap="onOpenAllWeak">查看全部</view></view><view class="weak-row" wx:for="{{weak}}" wx:key="card_id" data-id="{{item.card_id}}" bindtap="onOpenWeak"><view class="weak-topic">{{item.topic}}</view><view class="weak-reason">{{item.firstSignalLabel}}</view><view class="weak-action">建议：{{item.firstActionLabel}}</view></view><state-view wx:if="{{!weak.length}}" type="empty" title="暂未发现明确薄弱点" message="建议只会由真实学习记录触发"></state-view></view><button class="weekly-entry" bindtap="onOpenWeekly">进入本周混合测试</button></block></view>
