<view class="today-page"><view class="today-head"><view><view class="eyebrow">{{dateLabel || '今日计划'}}</view><view class="page-title">今日</view></view><view class="today-badge" wx:if="{{viewState === 'ready' || viewState === 'overloaded'}}">{{pendingCount}} 项待完成</view></view><state-view wx:if="{{viewState === 'loading'}}" type="loading" title="正在生成今日计划" message="会先安排到期复习，再加入薄弱练习和新内容"></state-view><state-view wx:elif="{{viewState === 'unauthorized'}}" type="unauthorized" title="需要重新登录" message="{{errorView.message}}" action-label="前往登录" bind:action="onLogin"></state-view><state-view wx:elif="{{viewState === 'onboarding'}}" type="empty" title="先完成学习档案" message="设置每天时间和学习日后，系统才能生成个人计划" action-label="继续设置" bind:action="onOpenOnboarding"></state-view><state-view wx:elif="{{viewState === 'error'}}" type="error" title="今日计划没有加载成功" message="{{errorView.message}}" action-label="重试" bind:action="onRetry"></state-view><state-view wx:elif="{{viewState === 'empty'}}" type="empty" title="今天暂时没有任务" message="可以从学科页加入章节，系统会按每天时间逐步引入"></state-view><state-view wx:elif="{{viewState === 'completed'}}" type="completed" title="今天的计划已完成" message="学习记录已经保存，下一批到期内容会自动进入计划"></state-view><block wx:else><plan-summary minutes="{{plan.estimated_minutes}}" due="{{plan.due_count}}" new-count="{{plan.new_count}}" weak="{{plan.weak_count}}" overloaded="{{plan.new_cards_paused}}"></plan-summary><button class="today-start" loading="{{starting}}" disabled="{{starting || adjusting}}" bindtap="onStart">开始今日学习</button><view class="budget-section"><view class="section-label">今天可用时间</view><view class="budget-control"><button wx:for="{{budgetOptions}}" wx:key="*this" data-minutes="{{item}}" disabled="{{adjusting}}" class="budget-option {{plan.effective_budget_minutes === item ? 'is-active' : ''}}" bindtap="onAdjustBudget">{{item}} 分钟</button></view></view><view class="today-alert" wx:if="{{viewState === 'overloaded'}}">当前负荷超过预算，今天只保留优先任务并暂停新增卡片。</view><view class="preview-section"><view class="section-row"><view class="section-label">接下来</view><view class="section-note">最多显示 5 项</view></view><view class="preview-row" wx:for="{{preview}}" wx:key="id"><view class="preview-index">{{item.index}}</view><view class="preview-copy"><view class="preview-title">{{item.label}}</view><view class="preview-reason">{{item.reason}}</view></view><view class="preview-time">约 {{item.minutes}} 分钟</view></view></view></block></view>
