.today-page{padding:32rpx 30rpx 120rpx}.today-head{height:104rpx;display:flex;align-items:flex-start;justify-content:space-between}.eyebrow{color:#6b777f;font-size:22rpx}.page-title{margin-top:6rpx;font-size:44rpx;font-weight:700;color:#17212b}.today-badge{margin-top:10rpx;padding:10rpx 14rpx;border-radius:6rpx;background:#e7f2ed;color:#17664d;font-size:22rpx}.today-start{margin-top:30rpx;height:94rpx;line-height:94rpx;border-radius:8rpx;background:#17664d;color:#fff;font-size:30rpx;font-weight:650}.today-start::after,.budget-option::after{border:0}.budget-section,.preview-section{margin-top:34rpx}.section-label{font-size:27rpx;font-weight:650;color:#26313a}.budget-control{display:flex;margin-top:16rpx}.budget-option{flex:1;margin-right:12rpx;height:72rpx;line-height:72rpx;padding:0;border-radius:7rpx;background:#fff;border:1rpx solid #ccd6d2;color:#53616b;font-size:23rpx}.budget-option:last-child{margin-right:0}.budget-option.is-active{background:#e7f2ed;border-color:#6ea18d;color:#17664d;font-weight:650}.today-alert{margin-top:24rpx;padding:18rpx;border-left:6rpx solid #c48a28;background:#fff5df;color:#714f18;font-size:23rpx;line-height:1.55}.section-row{display:flex;justify-content:space-between;align-items:center}.section-note{font-size:21rpx;color:#849098}.preview-row{height:112rpx;display:flex;align-items:center;border-bottom:1rpx solid #dfe5e2}.preview-index{width:48rpx;height:48rpx;line-height:48rpx;text-align:center;border-radius:50%;background:#e8eeec;color:#41544b;font-size:22rpx}.preview-copy{flex:1;min-width:0;margin-left:18rpx}.preview-title{font-size:27rpx;color:#26313a}.preview-reason{margin-top:7rpx;color:#77828a;font-size:21rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.preview-time{margin-left:16rpx;color:#66727d;font-size:21rpx;white-space:nowrap}
