.source-mask{position:fixed;z-index:30;left:0;right:0;top:0;bottom:0;background:rgba(17,25,31,.42);display:flex;align-items:flex-end}.source-panel{width:100%;max-height:78vh;background:#f7f8f7;border-radius:8rpx 8rpx 0 0;padding-bottom:env(safe-area-inset-bottom)}.source-head{height:92rpx;padding:0 28rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #dde4e1}.source-title{font-size:30rpx;font-weight:650}.source-close{margin:0;padding:0 8rpx;background:transparent;color:#17664d;font-size:24rpx}.source-close::after{border:0}.source-scroll{max-height:calc(78vh - 92rpx)}.source-warning{padding:16rpx 28rpx;background:#fff0ee;color:#8f382f;font-size:22rpx;line-height:1.5}.source-item{padding:26rpx 28rpx;border-bottom:1rpx solid #e1e6e4}.source-meta{font-size:23rpx;color:#415564}.source-path{margin-top:8rpx;color:#75818a;font-size:21rpx}.source-text{display:block;margin-top:18rpx;white-space:pre-wrap;font-size:27rpx;line-height:1.75;color:#202b32}
