.plan-summary{padding:28rpx 0;border-top:1rpx solid #e1e6e4;border-bottom:1rpx solid #e1e6e4}.plan-time{display:flex;align-items:baseline}.plan-number{font-size:64rpx;line-height:1;font-weight:700;color:#17212b}.plan-unit{margin-left:10rpx;color:#66727d;font-size:24rpx}.plan-metrics{display:flex;margin-top:26rpx}.plan-metrics>view{width:33.33%;border-right:1rpx solid #e1e6e4}.plan-metrics>view:last-child{border-right:0}.metric-value,.metric-label{display:block;text-align:center}.metric-value{font-size:32rpx;font-weight:600}.metric-label{margin-top:6rpx;color:#66727d;font-size:22rpx}.plan-alert{margin-top:22rpx;padding:16rpx;background:#fff4dc;color:#7a5310;border-radius:8rpx;font-size:23rpx}
