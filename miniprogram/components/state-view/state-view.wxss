.state{padding:64rpx 28rpx;text-align:center;color:#26313a}.state-mark{width:64rpx;height:64rpx;line-height:64rpx;margin:0 auto 20rpx;border-radius:50%;background:#e8eeec;color:#17664d;font-size:30rpx;font-weight:700}.state-error .state-mark{background:#f9e9e7;color:#a13d32}.state-unauthorized .state-mark{background:#e8edf2;color:#3e5568}.state-title{font-size:30rpx;font-weight:650}.state-message{margin-top:12rpx;color:#66727d;font-size:24rpx;line-height:1.6;white-space:normal}.state-action{margin-top:26rpx;width:260rpx;height:76rpx;line-height:76rpx;border-radius:8rpx;background:#17664d;color:#fff;font-size:26rpx}.state-action::after{border:0}
