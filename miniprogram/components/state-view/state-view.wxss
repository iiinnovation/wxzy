.state{padding:64rpx 28rpx;text-align:center;color:#26313a}.state-mark{width:64rpx;height:64rpx;line-height:64rpx;margin:0 auto 20rpx;border-radius:50%;background:#e8eeec;color:#0f766e;font-size:30rpx;font-weight:700}.state-error .state-mark{background:#f9e9e7;color:#a13d32}.state-unauthorized .state-mark{background:#e8edf2;color:#3e5568}.state-title{font-size:30rpx;font-weight:600}.state-message{margin-top:12rpx;color:#66727d;font-size:24rpx;line-height:1.6;white-space:normal}.state-action{display:flex;align-items:center;justify-content:center;margin-top:26rpx;width:260rpx;height:76rpx;border-radius:8rpx;background:#0f766e;color:#fff;font-size:26rpx}.state-action::after{border:0}@keyframes state-pulse{0%,100%{opacity:.4}50%{opacity:1}}.state-loading .state-mark{animation:state-pulse 1.2s ease-in-out infinite}
