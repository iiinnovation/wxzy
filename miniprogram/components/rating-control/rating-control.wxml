<view class="ratings" aria-label="回忆评分"><button disabled="{{disabled}}" data-rating="1" bindtap="onRate" class="rate again {{recommendedRating === 1 ? 'recommended' : ''}}"><text>没想起</text><text class="rate-hint">{{recommendedRating === 1 ? '建议 · Again' : 'Again'}}</text></button><button disabled="{{disabled}}" data-rating="2" bindtap="onRate" class="rate hard {{recommendedRating === 2 ? 'recommended' : ''}}"><text>较吃力</text><text class="rate-hint">{{recommendedRating === 2 ? '建议 · Hard' : 'Hard'}}</text></button><button disabled="{{disabled}}" data-rating="3" bindtap="onRate" class="rate good {{recommendedRating === 3 ? 'recommended' : ''}}"><text>记得</text><text class="rate-hint">{{recommendedRating === 3 ? '建议 · Good' : 'Good'}}</text></button><button disabled="{{disabled}}" data-rating="4" bindtap="onRate" class="rate easy {{recommendedRating === 4 ? 'recommended' : ''}}"><text>很熟悉</text><text class="rate-hint">{{recommendedRating === 4 ? '建议 · Easy' : 'Easy'}}</text></button></view>
