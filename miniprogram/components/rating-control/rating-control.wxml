<view class="ratings" aria-label="回忆评分"><button disabled="{{disabled}}" data-rating="1" bindtap="onRate" class="rate again"><text>没想起</text><text class="rate-hint">Again</text></button><button disabled="{{disabled}}" data-rating="2" bindtap="onRate" class="rate hard"><text>较吃力</text><text class="rate-hint">Hard</text></button><button disabled="{{disabled}}" data-rating="3" bindtap="onRate" class="rate good"><text>记得</text><text class="rate-hint">Good</text></button><button disabled="{{disabled}}" data-rating="4" bindtap="onRate" class="rate easy"><text>很熟悉</text><text class="rate-hint">Easy</text></button></view>
