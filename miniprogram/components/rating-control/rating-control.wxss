.ratings{display:flex;flex-wrap:wrap;gap:14rpx}.rate{box-sizing:border-box;width:calc(50% - 7rpx);height:94rpx;margin:0;border-radius:8rpx;font-size:26rpx;line-height:1.25;color:#26313a;background:#fff;border:1rpx solid #ccd6d2}.rate::after{border:0}.rate[disabled]{opacity:.55}.rate-hint{display:block;font-size:19rpx;margin-top:5rpx;color:#697680}.again{border-color:#d9a59f;background:#fff6f5}.hard{border-color:#dfbd78;background:#fff9ed}.good{border-color:#8ab8a6;background:#f3faf7}.easy{border-color:#8fa9bd;background:#f4f8fb}
